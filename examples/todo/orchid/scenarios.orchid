scenario "toggle a todo" {
  visit "/todos/b2"
  expect "#toggle" text "Mark done"
  click "#toggle"
  expect "#toggle" text "Mark open"
  click "#toggle"
  expect "#toggle" text "Mark done"
}

scenario "add a todo" {
  visit "/"
  expect "page:/ > Card[0]" visible
  fill "page:/ > #add > Stack[0] > Input[0]" "Buy matcha"
  submit "#add"
  expect "page:/ > Card[0] > for[0] > Stack[0] > Link[0]" count 4
  screenshot "after-add"
}

scenario "assistant renders a fragment" {
  visit "/assistant"
  expect "page:/assistant > Card[0]" visible
  expect "page:/assistant > Card[0]" contains "Where you're at"
  expect "page:/assistant > Card[0]" contains "still open"
}
