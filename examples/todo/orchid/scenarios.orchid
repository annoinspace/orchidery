scenario "toggle a todo" {
  visit "/todos/b2"
  expect "#toggle" text "Mark done"
  click "#toggle"
  expect "#toggle" text "Mark open"
  click "#toggle"
  expect "#toggle" text "Mark done"
}

scenario "add a todo" {
  visit "/"
  expect "page:/ > Card[0]" visible
  fill "page:/ > #add > Stack[0] > Input[0]" "Buy matcha"
  submit "#add"
  expect "island:TodoList > for[0] > Stack[0] > Link[0]" count 4
  screenshot "after-add"
}

scenario "assistant renders a fragment" {
  visit "/assistant"
  expect "page:/assistant > Card[0]" visible
  expect "page:/assistant > Card[0]" contains "Where you're at"
  expect "page:/assistant > Card[0]" contains "still open"
}

scenario "filter todos" {
  visit "/"
  expect "#filterAll" attr "class" "o-btn-primary"
  click "#filterDone"
  expect "#filterDone" attr "class" "o-btn-primary"
  expect "island:TodoList > for[0] > Stack[0] > Link[0]" count 1
  click "#filterOpen"
  expect "#filterOpen" attr "class" "o-btn-primary"
  expect "island:TodoList > for[0] > Stack[0] > Text[0]" contains "open"
  click "#filterAll"
  expect "#filterAll" attr "class" "o-btn-primary"
}

scenario "notes grown from a resource" {
  visit "/notes"
  expect "page:/notes > Stack[0] > for[0] > Link[0]" count 2
  fill "page:/notes > #create > Stack[0] > Input[0]" "Grown at runtime"
  submit "#create"
  expect "page:/notes > Stack[0] > for[0] > Link[0]" count 3
  click "page:/notes > Stack[0] > for[0] > Link[0]"
  expect "#title" contains "Resources grow into pages"
  expect "#remove" visible
}
